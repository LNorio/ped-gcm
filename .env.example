# Copie para .env e ajuste.
# URL base da API (produção: http://192.168.7.18:8080/api). Em desenvolvimento, deixe "/api" para usar o proxy do Vite.
VITE_API_URL=/api
# Servidor real para o qual o proxy do Vite encaminha as chamadas /api em desenvolvimento (evita CORS).
VITE_API_PROXY_TARGET=http://192.168.7.18:8080
